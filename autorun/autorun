#!/bin/sh
# SystemRescue açılışında otomatik çalışır (root, ana konsol). Disk(ler)i salt-okunur bağlar,
# tarar, ekrana renkli özet basar; ayrıntılı raporu USB'deki TESHIS bölümüne yazar.
BOOT=/run/archiso/bootmnt
T="$BOOT/usb-teshis"
echo; echo "=== USB TEŞHİS başlıyor — disk(ler) SALT-OKUNUR bağlanacak, hiçbir şey değiştirilmez ==="
[ -d "$T/usb_teshis" ] || { echo "Araç bulunamadı: $T"; exit 1; }

# Raporlar için TESHIS bölümünü yazılabilir bağla; olmazsa RAM'e yaz
OUT=""
DEV=/dev/disk/by-label/TESHIS
for i in 1 2 3 4 5; do [ -e "$DEV" ] && break; sleep 1; done
if [ -e "$DEV" ]; then
  mkdir -p /mnt/teshis
  mount -o rw "$DEV" /mnt/teshis 2>/dev/null && mkdir -p /mnt/teshis/raporlar && OUT=/mnt/teshis/raporlar
fi
if [ -z "$OUT" ]; then
  OUT=/tmp/raporlar; mkdir -p "$OUT"
  echo "(!) TESHIS bölümü yok/yazılamadı: rapor yalnızca RAM'e yazılıyor ($OUT), kapanınca kaybolur."
fi
STAMP=$(date +%Y%m%d_%H%M%S)
cd "$T" && python3 -m usb_teshis --mount --live-dmesg --brief --out "$OUT/rapor_$STAMP"
RC=$?
sync
echo
case "$RC" in 0|1) ;; *) echo "(!) Araç beklenmedik bir kodla bitti: $RC" ;; esac
echo "Ayrıntılı rapor: USB'de TESHIS bölümü > raporlar/rapor_$STAMP*.html  (tarayıcıda aç)"
echo "Kabuğa geçmek için Enter'a bas."
read -r _
exit 0

#!/bin/bash
# SystemRescue açılışında otomatik çalışır (root, ana konsol). Disk(ler)i salt-okunur bağlar,
# tarar, ekrana renkli özet basar; raporu ve ÇALIŞMA GÜNLÜĞÜNÜ USB'deki TESHIS bölümüne yazar.
LOG=/tmp/teshis_calisma.log
exec > >(tee "$LOG") 2>&1
BOOT=/run/archiso/bootmnt
echo; echo "=== USB TEŞHİS başlıyor — disk(ler) SALT-OKUNUR bağlanacak, hiçbir şey değiştirilmez ==="
echo "saat: $(date '+%F %T')  çekirdek: $(uname -r)  önyükleme: $(findmnt -no SOURCE "$BOOT" 2>/dev/null)"

# TESHIS bölümü: YALNIZCA açılış USB'sinin kendi diskinde aranır (bootmnt'un bağlı olduğu disk).
# Etiketle seçim yapılmaz: taranan (güvenilmeyen) bir disk "TESHIS"/"RESCUE1303" etiketi taklit edebilir.
BSRC=$(findmnt -no SOURCE "$BOOT" 2>/dev/null)
BPK=""
if [ -n "$BSRC" ]; then
  if [ "$(lsblk -dno TYPE "$BSRC" 2>/dev/null)" = disk ]; then BPK=$(basename "$BSRC")   # ISO tüm diskte (bölümsüz)
  else BPK=$(lsblk -no PKNAME "$BSRC" 2>/dev/null | head -1); fi                         # ISO bir bölümde
fi
PART=""
if [ -n "$BPK" ]; then
  for i in 1 2 3 4 5 6 7 8; do
    PART=$(lsblk -nrp -o NAME,LABEL,FSTYPE "/dev/$BPK" 2>/dev/null | awk '$2=="TESHIS" && $3=="exfat"{print $1; exit}')
    [ -n "$PART" ] && break; sleep 1
  done
fi
OUT=""
if [ -n "$PART" ]; then
  mkdir -p /mnt/teshis
  if mount -t exfat -o rw,nosuid,nodev,noexec "$PART" /mnt/teshis; then
    if [ -L /mnt/teshis/raporlar ]; then echo "(!) raporlar bir sembolik bağ: kullanılmıyor."
    else mkdir -p /mnt/teshis/raporlar && OUT=/mnt/teshis/raporlar; fi
  else echo "(!) $PART bağlanamadı."; fi
else
  echo "(!) Açılış USB'sinin TESHIS bölümü bulunamadı. Bölümler:"; lsblk -o NAME,SIZE,FSTYPE,LABEL,PKNAME
fi
if [ -z "$OUT" ]; then
  OUT=/tmp/raporlar; mkdir -p "$OUT"
  echo "(!) Rapor yalnızca RAM'e yazılıyor ($OUT), kapanınca kaybolur."
fi

# Araç HER ZAMAN salt-okunur ISO'dan çalışır; yazılabilir TESHIS bölümündeki hiçbir kod çalıştırılmaz.
T="$BOOT/usb-teshis"
[ -d "$T/usb_teshis" ] || { echo "(!) Araç bulunamadı: $T"; cp "$LOG" "$OUT/son_calisma.log" 2>/dev/null; exit 1; }

STAMP=$(date +%Y%m%d_%H%M%S)
cd "$T" && python3 -m usb_teshis --mount --live-dmesg --brief --out "$OUT/rapor_$STAMP"
RC=$?
echo "araç çıkış kodu: $RC"
sync; sleep 1
cp "$LOG" "$OUT/son_calisma.log" 2>/dev/null; sync
echo
echo "Ayrıntılı rapor + günlük: USB'de TESHIS bölümü > raporlar/  (rapor_$STAMP.html)"
echo "USB'yi çıkarıp çalışan bilgisayara tak. Kabuğa geçmek için Enter'a bas."
read -r _
exit 0
